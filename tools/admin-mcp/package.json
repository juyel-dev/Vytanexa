{
  "name": "vytanexa-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets an AI agent (OpenCode, Claude, Hermes, ...) work the Vytanexa admin moderation queues through the guarded /api/agent/* routes.",
  "type": "module",
  "bin": {
    "vytanexa-admin-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4"
  }
}
